# ===========================================
# Backtest Backend (FastAPI) 환경 변수 샘플
# ===========================================
# 네이티브(비 Docker) 실행용 샘플이다.
# 이 파일을 복사하여 .env 파일을 생성하세요:
# cp .env.example .env
#
# Docker Compose로 전체 스택을 띄울 때는 저장소 루트의
# .env.example 을 사용할 것 (compose.dev.yaml이 루트 .env를 참조한다).

# 서버 설정
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# 보안
SECRET_KEY=your-secret-key-here-change-in-production

# 백테스팅 설정 (미지정 시 app/core/config.py의 기본값 사용)
DEFAULT_INITIAL_CASH=10000
MAX_BACKTEST_DURATION_DAYS=3650
DEFAULT_COMMISSION=0.002

# 외부 API 설정
YAHOO_FINANCE_TIMEOUT=30

# CORS 설정 (쉼표로 구분된 도메인 목록)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5174,https://backtest.yeonjae.kr

# 데이터베이스 설정 (MySQL)
# 방법 1: 개별 설정
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_password
DATABASE_NAME=backtest

# 방법 2: URL 형식 (위 설정보다 우선)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/backtest

# 네이버 API (뉴스 검색 등)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
