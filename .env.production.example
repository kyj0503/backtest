# Copy to /opt/backtest/production/.env on OCI and chmod 600.
# Development uses /opt/backtest/development/.env with a separate DB/account.
# Never copy local-development sample passwords into a deployed environment.
DEBUG=false
LOG_LEVEL=INFO
DATABASE_HOST=replace-with-private-db-host
DATABASE_PORT=3306
DATABASE_NAME=stock_data_cache
DATABASE_USER=replace-with-app-user
DATABASE_PASSWORD=replace-on-server
SECRET_KEY=replace-on-server
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# DATABASE_URL, when present, overrides the individual DATABASE_* fields.
# VITE_* and frontend proxy settings are not backend runtime credentials.
