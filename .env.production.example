# Copy to /opt/backtest/production/.env on OCI and chmod 600.
# Development runs locally with compose.dev.yaml; OCI only hosts production.
# Never copy local-development sample passwords into a deployed environment.
DEBUG=false
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=replace-on-server
TURNSTILE_ALLOWED_HOSTNAMES=backtest.yeonjae.kr
TURNSTILE_EXPECTED_ACTION=backtest
LOG_LEVEL=INFO
DATABASE_HOST=replace-with-private-db-host
DATABASE_PORT=3306
DATABASE_NAME=stock_data_cache
DATABASE_USER=replace-with-app-user
DATABASE_PASSWORD=replace-on-server
# Managed MySQL TLS for the DATABASE_* fields: verify the chain with the OCI CA.
# The private host name is not in the certificate, so only the host name check is skipped.
DATABASE_SSL_CA=/app/tls/oracle-mysql-ca.pem
DATABASE_SSL_CHECK_HOSTNAME=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# DATABASE_URL, when present, overrides the individual DATABASE_* fields (SQLAlchemy form is accepted).
# Managed MySQL: mysql://user:pass@host:3306/stock_data_cache?charset=utf8mb4&ssl_ca=/app/tls/oracle-mysql-ca.pem&ssl_check_hostname=false
DATABASE_URL=
# Go connection pool (single process per container).
DATABASE_MAX_OPEN_CONNS=16
DATABASE_MAX_IDLE_CONNS=4
