# ===========================================
# Docker Compose (compose.dev.yaml) 환경 변수 샘플
# ===========================================
# compose.dev.yaml의 env_file이 이 디렉터리의 .env를 참조한다.
# 아래 명령으로 복사한 뒤 값을 채우면 된다:
#
#   cp .env.example .env
#   docker compose -f compose.dev.yaml up -d --build
#
# Rust 네이티브 실행은 이 환경변수를 셸에 주입한 뒤 cargo run --locked를 사용한다.
# .env 파일은 Compose가 읽으며 Rust 바이너리가 자동으로 읽지는 않는다.
#
# 주의: 여기 적힌 값은 로컬 개발 전용 더미다. 운영 값을 커밋하지 말 것.

########################################
# Rust / Axum
########################################

# Local development only; deployed runtime defaults to verification enabled.
TURNSTILE_ENABLED=false

# 서버 설정
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 로깅 설정 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# 실행·대기·부가 데이터 시간 제한 (초), 컨테이너당 단일 서버 프로세스
MAX_CONCURRENT_BACKTESTS=8
MAX_CONCURRENT_BACKTESTS_PER_CLIENT=2
BACKTEST_TIMEOUT_SECONDS=60
BACKTEST_QUEUE_TIMEOUT_SECONDS=30
SUPPLEMENTAL_DATA_TIMEOUT_SECONDS=15
MAX_CONCURRENT_MARKET_DATA=4
MARKET_DATA_TIMEOUT_SECONDS=20
MARKET_DATA_QUEUE_TIMEOUT_SECONDS=2
READINESS_DB_TIMEOUT_SECONDS=2

# 네이버 검색 API (뉴스 검색). 없으면 뉴스 기능만 비활성화된다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

########################################
# MySQL
########################################
# DATABASE_HOST는 compose.dev.yaml의 서비스명(mysql)이다. localhost가 아니다.
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=appuser
DATABASE_PASSWORD=appuser123
DATABASE_NAME=stock_data_cache
# DATABASE_URL이 있으면 위 개별 설정보다 우선한다.
# 운영 TLS: ssl_ca=/app/tls/oracle-mysql-ca.pem, ssl_check_hostname=false
DATABASE_URL=mysql+pymysql://appuser:appuser123@mysql:3306/stock_data_cache?charset=utf8mb4

# mysql 컨테이너 초기화용. 위 DATABASE_USER/DATABASE_PASSWORD와 일치시켜야 한다.
# 미지정 시 compose.dev.yaml의 기본값(localroot123 / appuser / appuser123)이 쓰인다.
MYSQL_ROOT_PASSWORD=localroot123
MYSQL_USER=appuser
MYSQL_PASSWORD=appuser123

########################################
# Frontend / Vite
########################################
# 프론트엔드는 별도 저장소의 compose.dev.yaml에서 실행한다.
#
# VITE_API_BASE_URL은 비워 두어야 한다.
# 서비스 레이어(features/backtest/services/backtestService.ts)가
# shared/api/client.ts의 axios 인스턴스에 전체 경로 `/api/v1/...`를 그대로
# 넘기므로, 여기에 `/api`를 넣으면 baseURL과 겹쳐 `/api/api/v1/backtest`가 되어
# vite 프록시에 매칭되지 않고 404가 난다. (`backtestApi.ts`라는 파일은 없다 —
# 삭제되었거나 존재한 적이 없다.)
# (운영 빌드는 이 값을 주입하지 않아 자연히 빈 값이 된다)
VITE_API_BASE_URL=
BACKTEST_PROXY_TARGET=http://host.docker.internal:8000
