# ===========================================
# Docker Compose (compose.dev.yaml) 환경 변수 샘플
# ===========================================
# compose.dev.yaml의 env_file이 이 디렉터리의 .env를 참조한다.
# 아래 명령으로 복사한 뒤 값을 채우면 된다:
#
#   cp .env.example .env
#   docker compose -f compose.dev.yaml up -d --build
#
# 서버 바이너리는 .env 파일을 직접 읽지 않는다. Compose가 환경 변수로 넣는다.
# 주의: 여기 적힌 값은 로컬 개발 전용 더미다. 운영 값을 커밋하지 말 것.

########################################
# Go 백엔드 (backtest_be_go)
########################################

# 로컬 개발 전용. 배포 런타임의 기본값은 검증 켜짐(true)이다.
TURNSTILE_ENABLED=false

HOST=0.0.0.0
PORT=8000
DEBUG=true

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# 계산 한도 (기본값과 같다. 바꿀 때만 주석을 푼다)
# MAX_BACKTEST_DURATION_DAYS=3650
# MIN_BACKTEST_PERIOD_DAYS=30
# DEFAULT_COMMISSION=0.002
# MAX_CONCURRENT_BACKTESTS=8
# MAX_CONCURRENT_BACKTESTS_PER_CLIENT=2

# Yahoo 요청 하나의 HTTP 타임아웃(초)
YAHOO_FINANCE_TIMEOUT=30

# 네이버 검색 API (뉴스). 없으면 뉴스 섹션만 비어 있다(supplemental_status.news=empty).
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# E2E 전용: 외부 Yahoo 대신 고정 시세 JSON을 쓴다. DEBUG=true일 때만 허용된다.
# BACKTEST_FIXTURE_FILE=/src/testdata/rust/histories.json

########################################
# MySQL
########################################
# DATABASE_HOST는 compose.dev.yaml의 서비스명(mysql)이다. localhost가 아니다.
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=appuser
DATABASE_PASSWORD=appuser123
DATABASE_NAME=stock_data_cache
# DATABASE_URL이 있으면 위 개별 설정보다 우선한다. SQLAlchemy 형식(mysql+pymysql://)도 받는다.
# 운영 TLS: ?charset=utf8mb4&ssl_ca=/app/tls/oracle-mysql-ca.pem&ssl_check_hostname=false
# (개별 설정을 쓰면 DATABASE_SSL_CA / DATABASE_SSL_CHECK_HOSTNAME)
DATABASE_URL=mysql://appuser:appuser123@mysql:3306/stock_data_cache?charset=utf8mb4

# mysql 컨테이너 초기화용. 위 DATABASE_USER/DATABASE_PASSWORD와 일치시켜야 한다.
# 미지정 시 compose.dev.yaml의 기본값(localroot123 / appuser / appuser123)이 쓰인다.
MYSQL_ROOT_PASSWORD=localroot123
MYSQL_USER=appuser
MYSQL_PASSWORD=appuser123

########################################
# Frontend / Vite (backtest-console 저장소)
########################################
# 콘솔의 Vite 프록시 기본 대상은 http://backtest-be-fast:8000 이다. compose.dev.yaml의 Go 서비스
# (backtest-be)가 같은 네트워크 별칭 backtest-be-fast를 가지므로 그대로 동작한다.
#
# VITE_API_BASE_URL은 비워 두어야 한다. 서비스 레이어가 전체 경로 `/api/v1/...`를 넘기므로
# `/api`를 넣으면 `/api/api/v1/backtest`가 되어 404가 난다.
VITE_API_BASE_URL=
API_PROXY_TARGET=http://backtest-be-fast:8000
FASTAPI_PROXY_TARGET=http://backtest-be-fast:8000
BACKTEST_PROXY_TARGET=http://backtest-be-fast:8000
