# Development Dockerfile for frontend
FROM node:20.19.0-alpine

# Install git for testing dependencies
RUN apk add --no-cache git

WORKDIR /app

# Install dependencies (cached at image build time)
# Install dependencies (cached at image build time)
COPY package*.json ./
RUN npm install

# Skip copying source code - use bind mount in compose.dev.yaml instead

ENV NODE_ENV=development

EXPOSE 5173

# Default command for development (start Vite on port 5173)
ENV PORT=5173
CMD ["npm", "run", "dev"]
